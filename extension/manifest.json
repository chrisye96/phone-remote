{
  "manifest_version": 3,
  "name": "手机遥控器助手",
  "version": "1.0",
  "description": "让手机遥控器能在任何网站上调倍速、跳 30 秒、跳过片头。",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
